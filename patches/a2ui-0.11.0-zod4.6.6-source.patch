+import {z} from 'zod';
+
+/**
+ * A2UI catalogs describe accepted input, not transformed output. Zod's Draft 7
+ * vocabulary is also valid in the existing 2019-09 catalog dialect. Retain that
+ * wire declaration, inline repeated schemas, and retain the legacy converter's
+ * closed-object description for objects whose parser strips unknown keys.
+ * Unsupported non-JSON types remain errors rather than becoming empty schemas.
+ */
+export function toCatalogJsonSchema(schema: z.ZodType): Record<string, any> {
+  const result = z.toJSONSchema(schema, {
+    target: 'draft-07',
+    io: 'input',
+    reused: 'inline',
+    override({zodSchema, jsonSchema}) {
+      delete jsonSchema.a2uiChildRef;
+      if (zodSchema._zod.def.type === 'object') {
+        if (!zodSchema._zod.def.catchall) jsonSchema.additionalProperties = false;
+        // The previous converter used isOptional(), including coercers that
+        // accept undefined. Preserve that input contract for function catalogs.
+        const shape = (zodSchema as z.ZodObject).shape;
+        const required = Object.keys(shape).filter(key => {
+          try {
+            return !shape[key].isOptional();
+          } catch {
+            // Match zod-to-json-schema's safeIsOptional fallback.
+            return false;
+          }
+        });
+        if (required.length) jsonSchema.required = required;
+        else delete jsonSchema.required;
+      }
+    },
+  });
+  return {...result, $schema: 'https://json-schema.org/draft/2019-09/schema#'};
+}
